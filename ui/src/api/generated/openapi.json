  "components": {
    "schemas": {
      "BinaryBody": {
        "type": "string",
        "format": "binary",
        "description": "Raw object bytes (upload body and download response)."
      },
      "BucketListResponse": {
        "type": "object",
        "required": [
          "buckets"
        ],
        "properties": {
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BucketSummary"
            }
          }
        }
      },
      "BucketSummary": {
        "type": "object",
        "required": [
          "name",
          "createdAt",
          "versioning",
          "encryption"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "encryption": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "versioning": {
            "type": "boolean"
          }
        }
      },
      "CreateBucketRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateFolderRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "EnabledResponse": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "EncryptionResponse": {
        "type": "object",
        "required": [
          "enabled",
          "algorithm"
        ],
        "properties": {
          "algorithm": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "accessKey",
          "secretKey"
        ],
        "properties": {
          "accessKey": {
            "type": "string"
          },
          "secretKey": {
            "type": "string"
          }
        }
      },
      "ObjectListResponse": {
        "type": "object",
        "required": [
          "files",
          "prefixes",
          "emptyPrefixes"
        ],
        "properties": {
          "emptyPrefixes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Prefixes that only contain a folder marker."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObjectSummary"
            }
          },
          "prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ObjectSummary": {
        "type": "object",
        "required": [
          "key",
          "size",
          "lastModified",
          "etag"
        ],
        "properties": {
          "etag": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "lastModified": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ObjectVersion": {
        "type": "object",
        "required": [
          "versionId",
          "lastModified",
          "size",
          "etag",
          "isDeleteMarker"
        ],
        "properties": {
          "etag": {
            "type": "string"
          },
          "isDeleteMarker": {
            "type": "boolean"
          },
          "lastModified": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "versionId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OkResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "PresignResponse": {
        "type": "object",
        "required": [
          "url",
          "expiresIn"
        ],
        "properties": {
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        }
      },
      "PublicAccess": {
        "type": "object",
        "required": [
          "read",
          "list"
