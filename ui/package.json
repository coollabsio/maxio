    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
