{
  "name": "maxio-ui",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern dist --ignore-pattern src/api/generated",
    "test": "bun test src --pass-with-no-tests",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "e2e": "playwright test",
    "api:generate": "bun run scripts/generate-api.ts src/api/generated/openapi.json src/api/generated",
    "icons": "bun run scripts/generate-icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
